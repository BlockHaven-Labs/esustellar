# ==============================================================================
# EsuStellar — Top-Level Local Development Environment Template (.env.example)
# ==============================================================================
#
# RELATIONSHIP BETWEEN EXAMPLE-ENV / SECRETS FILES:
# ------------------------------------------------------------------------------
# 1. .env.example (This file - Root):
#    - Purpose: App-level local development defaults.
#    - Audience: Frontend/fullstack contributors running docker-compose or
#      apps/web locally with default local or testnet endpoints.
#    - Copy to: .env in repository root (or apps/web/.env.local) for local dev.
#
# 2. infra/secrets/templates/.env.example:
#    - Purpose: Infra-level configuration template and canonical secrets reference.
#    - Audience: DevOps, SRE, and CI/CD operations covering all environment
#      variables across the entire monorepo (monitoring, Docker registry, deployer
#      keys, cloud parameters).
#    - Copy to: .env for full-stack infra automation or refer to when setting
#      Kubernetes / GitHub Actions secrets.
#
# 3. environments/testnet/config/secrets.example:
#    - Purpose: Testnet-specific overrides for file-based Docker Compose secrets.
#    - Audience: Contributors running the localized testnet sandbox
#      (environments/testnet/docker-compose.yml) requiring quickstart seeds and
#      Stellar network credentials.
#    - Copy to: Individual text files under environments/testnet/config/secrets/
#      (e.g., soroban_rpc_url.txt, stellar_network_passphrase.txt, stellar_seed.txt).
#
# For full secrets inventory and rotation guidelines, see:
# - docs/env-vars.md
# - infra/secrets/README.md
# ==============================================================================

# ------------------------------------------------------------------------------
# Stellar / Soroban Configuration (Testnet defaults)
# ------------------------------------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ------------------------------------------------------------------------------
# Web Frontend (apps/web) Environment Variables
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed Contract IDs (populated after running ./deploy.sh or sync-contract-ids.sh)
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_SAVINGS_CONTRACT_ID=
NEXT_PUBLIC_CONTRACT_ID=

# ------------------------------------------------------------------------------
# Local Docker / Nginx / Monitoring Services
# ------------------------------------------------------------------------------
# Place TLS certificates at nginx/certs/cert.pem and nginx/certs/key.pem if using HTTPS
GRAFANA_ADMIN_PASSWORD=admin
