# ==============================================================================
# Stellar Testnet Secrets Template (Docker Compose Secrets)
# ==============================================================================
# RELATIONSHIP TO OTHER EXAMPLE-ENV FILES:
#   - environments/testnet/config/secrets.example (this file): Testnet-specific
#     overrides for file-based Docker Compose secrets (quickstart node seed,
#     Soroban RPC endpoint, and network passphrase).
#   - .env.example (top-level): App-level local dev defaults for contributors.
#   - infra/secrets/templates/.env.example: Canonical reference for infra-level
#     configuration and monorepo-wide environment variables.
#
# USAGE:
# Copy the values into individual text files in environments/testnet/config/secrets/:
#   - environments/testnet/config/secrets/stellar_seed.txt
#   - environments/testnet/config/secrets/soroban_rpc_url.txt
#   - environments/testnet/config/secrets/stellar_network_passphrase.txt
# ==============================================================================

# Stellar seed for the RPC node (if running local quickstart)
# stellar_seed=

# Soroban RPC URL (if using custom RPC)
# soroban_rpc_url=

# Stellar network passphrase
# stellar_network_passphrase=Test SDF Network ; September 2015
